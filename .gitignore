# ========== Unity ==========

# User-specific files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb

# Unity-generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/*
[Uu]serSettings/
[Ss]creenshots/
[Rr]ecordings/
MemoryCaptures/

# Allow 3D model files
!Assets/**/*.obj
!Assets/**/*.fbx
!Assets/**/*.blend
!Assets/**/*.glb
!Assets/**/*.gltf

# Allow the Library folder in the Steamworks AppMedia directory
!AppMedia/Steamworks/Library/

# Cache & logs
*.log
*.stacktrace
.crash/

# Autogenerated VS/Rider files
.vscode/
*.code-workspace

# Ignore the entire .idea folder
.idea/

# But allow shared code styles or inspection settings
!.idea/codeStyles/
!.idea/inspectionProfiles/
!.idea/dictionaries/

# Mono auto-generated files
*.pidb
*.symbols

# Unity Cloud Build
.cloud/

# Visual Studio Code settings
.vs
.vscode/

# Rider settings
.idea/
*.sln.iml

# Unity Collaborate cache
.collab/

# JetBrains Rider project settings
*.sln.dotCover

# Crash reports
sysinfo.txt

# Shader cache
*.shadercache
*.giparams

# Unity3D meta files that should stay
!Assets/**/*.meta

# ========== OS ==========

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

Assets/AddressableAssetsData/AssetGroups/*.bin
Assets/AddressableAssetsData/AssetGroups/*.blob

!Assets/Plugins/**/*.dll
!Assets/Plugins/**/*.bundle
!Assets/Scripts/Steamworks/
!Assets/Scripts/Discord/
!Assets/Plugins/Demigiant/
!Assets/ThirdParty/

# Builds
/Builds/*.zip
/Builds/*.tar
/Builds/*.tar.*

packages/

# ========== FMOD ==========

!/[Aa]ssets/Plugins/FMOD/**/lib/*

!/[Aa]ssets/Gizmos/FMOD/*
!/[Aa]ssets/Editor Default Resources/FMOD/*

/[Aa]ssets/Plugins/FMOD/Cache/*

/[Aa]ssets/StreamingAssets/**/*.bank
/[Aa]ssets/StreamingAssets/**/*.bank.meta

fmod_editor.log